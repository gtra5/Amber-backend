# Copy this file to ".env" and fill in real values. NEVER commit ".env".

PORT=3000
NODE_ENV=development
# Only used for browsers (CORS). The phone app does not need it.
CLIENT_URL=http://localhost:8081
# 0 on your own computer; 1 behind one reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=0

# MongoDB connection string (URL-encode special characters in the password)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/amber-sos?retryWrites=true&w=majority

# Two DIFFERENT long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
INVITE_HMAC_SECRET=

# base64 of the Firebase service-account JSON (one line, no quotes):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_BASE64=

# iPhone critical alerts: keep false until Apple approves the entitlement
CRITICAL_ALERTS_ENABLED=false

# ── Invitations: QR codes and email ─────────────────────────────────────────
# Public https address of THIS server. Invite links in emails and QR codes point here.
# Phones only open app links over https; use a real domain or a tunnel (e.g. ngrok) for testing.
APP_LINK_BASE_URL=https://amber.example.com

# Email (Nodemailer). Without SMTP_HOST + MAIL_FROM, email invitations are disabled
# (QR and 10-character code invitations keep working).
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Amber SOS <no-reply@example.com>"
# Development only: build the email and print it in the console instead of sending it
EMAIL_DRY_RUN=false

# How long invitations last
QR_INVITE_TTL_MINUTES=10
EMAIL_INVITE_TTL_HOURS=48
# Email invitations can only be accepted by the account whose email it was sent to.
# Keep "true". (Registration does not verify emails yet: see README.)
INVITE_REQUIRE_EMAIL_MATCH=true

# Lets phones open invite links straight in the app (served at /.well-known/...)
ANDROID_PACKAGE=com.amber.sos
# SHA-256 fingerprint(s) of the app's signing certificate, comma separated
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.amber.sos
# Shown on the web page when the app is not installed (optional)
IOS_APP_STORE_URL=
ANDROID_PLAY_URL=
